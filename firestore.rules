rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
function signed(){return request.auth != null;}
function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
function active(){return signed() && me().active == true;}
function admin(){return active() && me().role == 'admin';}
function teacher(c){return active() && me().role == 'teacher' && me().course == c;}
function student(c){return active() && me().role == 'student' && me().course == c;}
function own(d){return active() && d.uid == request.auth.uid;}
match /users/{uid}{allow read: if signed() && (request.auth.uid == uid || admin()); allow create: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','email','role','active','course']) && request.resource.data.role == 'student' && request.resource.data.active == false && request.resource.data.course == 'obe' && request.resource.data.email == request.auth.token.email; allow update,delete: if admin();}
match /courses/{id}{allow read: if active(); allow write: if admin();}
match /modules/{id}{allow read: if admin() || teacher(resource.data.course) || student(resource.data.course); allow create: if admin() || teacher(request.resource.data.course); allow update: if admin() || (teacher(resource.data.course) && request.resource.data.course == resource.data.course); allow delete: if admin() || teacher(resource.data.course);}
match /submissions/{id}{allow read: if admin() || own(resource.data) || teacher(resource.data.course); allow create: if own(request.resource.data) && student(request.resource.data.course) && request.resource.data.keys().hasOnly(['uid','course','module','number','answer']) && id == request.auth.uid + '-' + request.resource.data.module && get(/databases/$(database)/documents/modules/$(request.resource.data.module)).data.course == request.resource.data.course && get(/databases/$(database)/documents/modules/$(request.resource.data.module)).data.number == request.resource.data.number; allow update: if (admin() || (teacher(resource.data.course) && resource.data.number != 11)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks']) && request.resource.data.marks is number && request.resource.data.marks >= 0 && request.resource.data.marks <= 100;}
match /doubts/{id}{allow read: if admin() || own(resource.data) || teacher(resource.data.course); allow create: if own(request.resource.data) && student(request.resource.data.course) && request.resource.data.reply == ''; allow update: if (admin() || teacher(resource.data.course)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply']);}
match /feedback/{id}{allow read: if admin(); allow create: if own(request.resource.data) && me().role == 'student';}
match /certificates/{uid}{allow read: if admin() || (active() && request.auth.uid == uid); allow write: if admin();}
match /progress/{id}{allow read: if admin() || own(resource.data); allow create: if own(request.resource.data) && me().role == 'student'; allow update: if own(resource.data) && own(request.resource.data) && me().role == 'student';}
}}
